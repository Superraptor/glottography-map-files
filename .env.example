# ========================================================
# Glottography to Wikimedia Commons Configuration
# ========================================================

# Zenodo Community Settings
ZENODO_COMMUNITY=glottography
ZENODO_API_BASE=https://zenodo.org/api
# Optional Zenodo API token for higher rate limits:
# ZENODO_TOKEN=your_zenodo_token_here

# Wikimedia Commons Credentials (MediaWiki Bot Password)
# Create a Bot Password at: https://commons.wikimedia.org/wiki/Special:BotPasswords
# Give it the "Edit existing pages" and "Create, edit, and move pages" grants.
COMMONS_USERNAME=YourBotOrUsername@BotName
COMMONS_BOT_PASSWORD=your_bot_password_here

# API & Etiquette Settings (MediaWiki Bot Policy)
COMMONS_API_URL=https://commons.wikimedia.org/w/api.php
USER_AGENT=GlottographyCommonsBot/1.0 (https://github.com/Superraptor/glottography-map-files; contact: https://commons.wikimedia.org/wiki/User_talk:Superraptor)
BOT_OPERATOR=Superraptor
BOT_CONTACT=https://commons.wikimedia.org/wiki/User_talk:Superraptor

# MediaWiki Categories
CATEGORY_NAME=Map data of languages
PARENT_CATEGORY=Map data by object
PARENT_SORTKEY=Languages

# Rate Limiting & Execution
REQUEST_DELAY=2.0       # Seconds between upload requests
MAXLAG=5                # MediaWiki maxlag parameter (seconds)
MAX_RETRIES=5           # Exponential backoff retries on rate limits / server load
DRY_RUN=false           # Set to true to simulate without editing Wikimedia Commons

# Map Processing
COORDINATE_PRECISION=5  # Decimal places (~1.1 meter resolution, optimizes JSON file size)
DATA_DIR=data           # Local directory for downloads, extracted files, maps, and state DB

